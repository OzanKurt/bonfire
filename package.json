{
    "name": "@ozankurt/bonfire",
    "version": "1.1.0",
    "description": "Dramatic full-screen notifications and dialogs inspired by Soulsborne games",
    "keywords": [
        "notifications",
        "dialog",
        "confirm",
        "ui"
    ],
    "license": "MIT",
    "author": {
        "name": "Ozan Kurt",
        "email": "me@ozankurt.com",
        "url": "https://ozankurt.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OzanKurt/bonfire.git"
    },
    "homepage": "https://github.com/OzanKurt/bonfire#readme",
    "bugs": "https://github.com/OzanKurt/bonfire/issues",
    "type": "module",
    "main": "dist/bonfire.cjs",
    "module": "dist/esm/bonfire.mjs",
    "types": "dist/bonfire.d.ts",
    "unpkg": "dist/bonfire.min.js",
    "jsdelivr": "dist/bonfire.min.js",
    "exports": {
        ".": {
            "types": "./dist/bonfire.d.ts",
            "import": "./dist/esm/bonfire.mjs",
            "require": "./dist/bonfire.cjs",
            "default": "./dist/esm/bonfire.mjs"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "node ./scripts/build.js",
        "test": "vitest run",
        "prepublishOnly": "npm test && npm run typecheck && npm run build",
        "examples": "vite --config vite.examples.config.js",
        "screenshots": "node scripts/screenshots.js",
        "typecheck": "tsc -p tsconfig.types.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@playwright/test": "1.63.0",
        "esbuild": "^0.28.2",
        "happy-dom": "^21.0.3",
        "typescript": "^5.9.3",
        "vite": "8.3.4",
        "vitest": "^5.0.5"
    }
}
